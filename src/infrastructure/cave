#!/bin/bash
#!/usr/bin/env python3

# exit on errors
set -e

directory=$(pwd)
source "$directory/../../.venv/bin/activate"

mkdir -p logs

intexit() {
    # Kill all subprocesses (all processes in the current process group)
    kill -HUP -$$
}

hupexit() {
    # HUP'd (probably by intexit)
    echo
    echo "Interrupted"
    exit
}

extract() {
    printf 'Available files:\n'
    ls *.pcap
    read -rep $'\nType pcap file from list: ' fileName
    
    tshark -r $fileName --disable-protocol wsmp -Tfields -Eseparator=, -e data.data > pcapOutput.txt
}

processing() {
    extract # comment if same SPAT file will be used
    python3 $directory/tscScript.py &
    python3 $directory/trafficSignal.py &
}

trap hupexit HUP
trap intexit INT

cave_start()
{
    # Ensure logs directory exists and is writable
    mkdir -p $DIR/logs
    sudo chmod 777 $DIR/logs

    processing
}

cave_stop()
{
    pkill -f msgIntersect.py & pkill -f tscScript.py
}

cave_echo()
{
    cd $DIR/logs/
    latest_log=$(ls -t *.log | head -1)
    tail -f $latest_log
}


mode=$1
echo "$0 is called with parameter: '$mode'"

case $mode in
    "start")
        cave_start
        ;;
    "stop")
        cave_stop
        ;;
    "restart")
        cave_stop
        cave_start
        ;;
    "echo")
        cave_echo
        ;;
    *)
        ;;
esac

# Block on the backgrounded python scripts so SIGINT reaches the trap
wait
